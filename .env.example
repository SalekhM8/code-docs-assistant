# Copy to .env. Only the two API keys are needed for the reviewer flow.

# --- Providers -------------------------------------------------------------
# Set both to "fake" to run with no keys (deterministic stand-ins, used by all tests).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Answers (Sonnet tier) and cheap steps such as overviews and titles (Haiku tier). Checked 2026-11-21.
ANSWER_MODEL=claude-sonnet-5-5
CHEAP_MODEL=claude-haiku-5-5

EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
# Voyage code model. Must output 1024 dimensions (the db column size).
EMBEDDING_MODEL=voyage-code-4

# baseline = one-shot hybrid search; agent = tool loop (max 6 steps)
ANSWER_MODE=agent
# Fake model only: delay per streamed word (ms), so a key-less demo streams visibly.
FAKE_STREAM_DELAY_MS=0

# --- Infrastructure ----------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cda
PORT=8787
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787
LOG_LEVEL=info
# Optional: raises the GitHub API rate limit used for the public-repo check.
GITHUB_TOKEN=

# --- Sample repo seeded on start -----------------------------------------------
SEED_SAMPLE_REPO=true
SAMPLE_REPO_URL=https://github.com/tj/commander.js
SAMPLE_REPO_COMMIT=a5a7dc084d4d2b7932e85ca049c5204e50a2c721

# --- Limits ------------------------------------------------------------------
MAX_REPO_SIZE_MB=100
MAX_FILE_COUNT=3000
MAX_FILE_BYTES=300000
MAX_AGENT_STEPS=6
MAX_TOKENS_PER_ANSWER=120000
RATE_LIMIT_PER_MINUTE=20

# --- Optional Langfuse export (traces are always stored in Postgres) -----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Tests -------------------------------------------------------------------
# Leave empty to let integration tests start a pgvector container with Testcontainers.
TEST_DATABASE_URL=
