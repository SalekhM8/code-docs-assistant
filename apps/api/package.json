{
  "name": "@cda/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=../../.env src/evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@cda/shared": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
